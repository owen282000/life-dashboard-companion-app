<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows: the widget as it stands before the first sync. A launcher inflates this, without AppCompat, so android:tint is the right one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ground"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:scaleType="fitStart"
        android:src="@drawable/widget_pulse_flat"
        android:tint="@color/widget_flat"
        tools:ignore="UseAppTint" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        android:text="@string/widget_preview_count"
        android:textColor="@color/widget_text"
        android:textSize="34sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/widget_preview_records"
        android:textColor="@color/widget_muted"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:text="@string/widget_no_syncs"
        android:textColor="@color/widget_muted"
        android:textSize="11sp" />
</LinearLayout>

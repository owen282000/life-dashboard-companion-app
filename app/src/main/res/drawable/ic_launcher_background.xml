<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon background: the same near-black ground as docs/social-preview.png, so the icon,
  the banner and the store listing read as one identity. Adaptive icons are 108dp with only the
  central 72dp guaranteed visible, hence a flat fill rather than artwork near the edges.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#101619"
        android:pathData="M0,0h108v108h-108z" />
</vector>

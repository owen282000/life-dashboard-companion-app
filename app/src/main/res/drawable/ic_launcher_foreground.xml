<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground: the heartbeat trace from docs/social-preview.png, drawn inside the
  72dp safe zone of the 108dp adaptive canvas (18dp inset on every side) so no launcher mask
  clips the spike. The stroke is deliberately heavy: at 48dp a thin line disappears.

  Also used as the monochrome layer for themed icons, which is why it is a single shape in one
  colour with no background of its own.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Heartbeat trace: flat line, upstroke, deep downstroke, recovery, flat line out. -->
    <path
        android:pathData="M26,54 L40,54 L46,36 L54,72 L60,50 L66,54 L82,54"
        android:strokeColor="#10B981"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Endpoint dot, the same "signal arrives here" cue the banner uses. -->
    <path
        android:pathData="M82,54m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0"
        android:fillColor="#10B981" />
</vector>

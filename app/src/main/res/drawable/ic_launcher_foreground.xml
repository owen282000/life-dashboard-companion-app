<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground: the heartbeat-broadcast mark from docs/brand/icon.html, the
  variant chosen on 2026-09-14. The pulse is measured AND published: the endpoint dot
  radiates two signal arcs, which is exactly what the app does with the data.

  Drawn inside the 72dp safe zone of the 108dp adaptive canvas (18dp inset on every side)
  so no launcher mask clips the outer arc. Also used as the monochrome layer for themed
  icons, hence one colour with per-path alpha and no background of its own.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Pulse: flat line, spike, deep dip, recovery, flat out. -->
    <path
        android:pathData="M19,54 L34,54 L40,38 L50,70 L57,47 L62,54 L67,54"
        android:strokeColor="#30B77E"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Endpoint dot: the signal arrives here, then gets published. -->
    <path
        android:pathData="M67,54m-4.2,0a4.2,4.2 0,1 1,8.4 0a4.2,4.2 0,1 1,-8.4 0"
        android:fillColor="#30B77E" />

    <!-- Broadcast arcs. -->
    <path
        android:pathData="M76.5,46 A12,12 0 0 1 76.5,62"
        android:strokeColor="#30B77E"
        android:strokeWidth="4.2"
        android:strokeLineCap="round"
        android:strokeAlpha="0.85" />
    <path
        android:pathData="M83.5,39.5 A21,21 0 0 1 83.5,68.5"
        android:strokeColor="#30B77E"
        android:strokeWidth="4.2"
        android:strokeLineCap="round"
        android:strokeAlpha="0.5" />
</vector>

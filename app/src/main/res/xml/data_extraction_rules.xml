<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (cloud backup and device-to-device transfer). Same rules as backup_rules.xml:
  configuration is carried over, secrets and raw health payloads are not.

  life_dashboard_secrets.xml is encrypted with a Keystore key that never leaves the device, so
  a restored copy is useless at best; life_dashboard_secure_prefs.xml is where versions 1.6.0
  to 1.22 kept the secrets (security-crypto) and stays excluded while it can exist.
  life_dashboard_logs.xml holds raw webhook payloads (full health data, incl. cycle tracking).
  life_dashboard_writeback.xml is the Receive ledger, this install's state like the watermarks.

  device-transfer could in principle keep the secure prefs, since the keystore may migrate on
  some direct transfers, but that is not guaranteed across OEMs. Excluding it in both places
  keeps the guarantee simple: secrets never leave this device.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="life_dashboard_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="life_dashboard_secrets.xml"/>
        <exclude domain="sharedpref" path="life_dashboard_logs.xml"/>
        <exclude domain="sharedpref" path="life_dashboard_writeback.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="life_dashboard_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="life_dashboard_secrets.xml"/>
        <exclude domain="sharedpref" path="life_dashboard_logs.xml"/>
        <exclude domain="sharedpref" path="life_dashboard_writeback.xml"/>
    </device-transfer>
</data-extraction-rules>

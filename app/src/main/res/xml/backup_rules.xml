<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below (full-backup). Settings are backed up so a new device keeps the
  user's configuration, but never the secrets or the health payloads:

  - life_dashboard_secrets.xml holds webhook auth headers, HMAC signing secrets and MQTT
    credentials, encrypted with an AES key that lives in the Android Keystore and is NOT
    backed up, so a restored copy could never be decrypted. life_dashboard_secure_prefs.xml
    is where versions 1.6.0 to 1.22 kept them (security-crypto); it stays excluded for as
    long as it can exist on a phone.
  - life_dashboard_logs.xml holds raw webhook payloads, i.e. full health data including
    cycle tracking. That must never leave the device through a cloud backup.

  - life_dashboard_writeback.xml is the Receive ledger: which readings from Home Assistant
    were written and their Health Connect ids. It describes this install's state, like the
    sync watermarks, so a new phone starts afresh and the integration re-offers what was
    not acknowledged; the upsert makes that harmless.

  Secrets have to be re-entered after a restore, which is the deliberate trade-off until a
  dedicated settings export/import exists.
-->
<full-backup-content>
    <include domain="sharedpref" path="."/>
    <exclude domain="sharedpref" path="life_dashboard_secure_prefs.xml"/>
    <exclude domain="sharedpref" path="life_dashboard_secrets.xml"/>
    <exclude domain="sharedpref" path="life_dashboard_logs.xml"/>
    <exclude domain="sharedpref" path="life_dashboard_writeback.xml"/>
</full-backup-content>

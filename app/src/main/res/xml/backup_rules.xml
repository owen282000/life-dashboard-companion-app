<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below (full-backup). Settings are backed up so a new device keeps the
  user's configuration, but never the secrets or the health payloads:

  - life_dashboard_secure_prefs.xml holds webhook auth headers, HMAC signing secrets and
    MQTT credentials. Its AES key lives in the hardware keystore and is NOT backed up, so
    restoring the file elsewhere would at best be undecryptable and at worst (if it was
    written while the keystore was unavailable) leak cleartext secrets off-device.
  - life_dashboard_logs.xml holds raw webhook payloads, i.e. full health data including
    cycle tracking. That must never leave the device through a cloud backup.

  Secrets have to be re-entered after a restore, which is the deliberate trade-off until a
  dedicated settings export/import exists.
-->
<full-backup-content>
    <include domain="sharedpref" path="."/>
    <exclude domain="sharedpref" path="life_dashboard_secure_prefs.xml"/>
    <exclude domain="sharedpref" path="life_dashboard_logs.xml"/>
</full-backup-content>
